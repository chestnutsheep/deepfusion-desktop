{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepFusion Desktop",
  "version": "0.1.0",
  "identifier": "com.deepfusion.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5188",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5188",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepFusion",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": false,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "focus": true,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
